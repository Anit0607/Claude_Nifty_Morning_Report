# Copy this file to `.env` and fill in values. NEVER commit `.env`.

# Dhan API. The token is capped at 24h (SEBI rule), but the Refresh Dhan Token workflow
# calls /v2/RenewToken twice daily and rewrites the secret, so no daily login is needed.
# Bootstrap once from web.dhan.co; only re-bootstrap if the chain fully lapses.
DHAN_ACCESS_TOKEN=
DHAN_CLIENT_ID=

# GitHub PAT with "Secrets: read and write" on this repo — lets the refresh workflow
# rewrite DHAN_ACCESS_TOKEN. Stored as the GH_SECRETS_TOKEN repository secret (CI only).
GH_TOKEN=

# Email delivery (Gmail) — primary channel. EMAIL_APP_PASSWORD is a Google App Password
# (needs 2FA on the account), NOT your normal password. EMAIL_TO can be comma-separated.
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_TO=

# Telegram delivery (optional / banned in IN) — leave blank to disable
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OPTIONAL — only needed for the richer LLM narration/diagnosis layer.
# The system runs fully without this (deterministic report).
ANTHROPIC_API_KEY=
